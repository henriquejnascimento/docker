# .env

# Dados do container Postgres externo (projeto "postgreSQL"). PG_DB é criado
# automaticamente pelo serviço airflow-db-init caso ainda não exista.
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=root
PG_DB=airflow

# UID do seu usuário no host (rode "id -u" para conferir), usado para os containers
# não escreverem dags/logs como root/uid 50000
AIRFLOW_UID=50000

# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Usuário admin criado pelo serviço airflow-init
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_WWW_USER_EMAIL=airflow@example.com
