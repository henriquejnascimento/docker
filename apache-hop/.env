# Dados do container Postgres externo (projeto "postgreSQL"). PG_DB é criado
# automaticamente pelo serviço hop-db-init caso ainda não exista.
# Mantenha PG_DB em sincronia com o valor de PG_DB em config/environment.json.
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=root
PG_DB=apache_hop
