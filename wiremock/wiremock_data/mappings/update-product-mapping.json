{
  "request": {
    "method": "PUT",
    "urlPattern": "/products/([0-9]+)",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.name)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "update-product-response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
