{
  "request": {
    "method": "POST",
    "url": "/products",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.name)]"
      }
    ]
  },
  "response": {
    "status": 201,
    "bodyFileName": "create-product-response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
